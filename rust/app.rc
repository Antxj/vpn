// VPN resources: icon, UAC manifest and version information.

1 ICON "assets/icon.ico"

// RT_MANIFEST (type 24), id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID
1 24 "assets/app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,2,0
PRODUCTVERSION 1,0,2,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", "VPN - OpenVPN with automatic TOTP token"
      VALUE "FileVersion", "1.0.2"
      VALUE "ProductName", "VPN"
      VALUE "ProductVersion", "1.0.2"
      VALUE "OriginalFilename", "VPN.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 0x04B0
  END
END
